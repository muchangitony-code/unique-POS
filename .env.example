# ── Required ────────────────────────────────────────────────────────────────
# Railway injects this at runtime. Keep unset in source-controlled files.
# DATABASE_URL=

# Deployment-specific random secret; startup validation rejects placeholders.
# SESSION_SECRET=

# Port the app listens on. On cPanel/Passenger this is set automatically.
# PORT=3000

# ── Migration deployment only ──────────────────────────────────────────────
# These are NOT required by normal application startup.
# MIGRATION_DEPLOY_TOKEN=
# MIGRATION_CONFIRMATION=APPLY_MIGRATIONS
#
# Only for a specifically approved destructive migration:
# MIGRATION_ALLOW_DESTRUCTIVE=YES
# MIGRATION_DESTRUCTIVE_APPROVAL=APPROVE_DESTRUCTIVE_MIGRATION
# MIGRATION_APPROVED_FILES=0012_example.sql
# MIGRATION_BACKUP_FILE=/absolute/path/to/fresh/pre-migration.dump
# MIGRATION_MAX_BACKUP_AGE_MS=900000

# ── Optional ────────────────────────────────────────────────────────────────
# APP_URL=https://pos.yourdomain.com
# SMTP_PASSWORD=

# Bootstrap administrator. Credentials must be supplied through the deployment
# environment; do not commit a real password.
# UNIQUEPOS_BOOTSTRAP_ADMIN=1
# UNIQUEPOS_BOOTSTRAP_ADMIN_USERNAME=
# UNIQUEPOS_BOOTSTRAP_ADMIN_EMAIL=
# UNIQUEPOS_BOOTSTRAP_ADMIN_PASSWORD=
# UNIQUEPOS_BOOTSTRAP_ADMIN_ROTATE_PASSWORD=0

# Storage locations
# SERVE_CLIENT_DIR=./public
# BACKUP_DIR=./backups
# LOCAL_STORAGE_DIR=./storage
