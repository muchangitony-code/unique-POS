# ── Required ────────────────────────────────────────────────────────────────
# Railway injects this at runtime. Keep unset in source-controlled files.
# For local development only, export a real provider connection string in your shell.
# DATABASE_URL=

# Secret used to sign login tokens. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the app listens on. On cPanel/Passenger this is set automatically —
# leave it unset there. For a manual "npm start" run, set it (e.g. 3000).
# PORT=3000

# ── Optional ────────────────────────────────────────────────────────────────
# Public URL of the app, used for links in alert/backup emails.
# APP_URL=https://pos.yourdomain.com

# SMTP password for outgoing email (host/port/user are set in-app under Settings).
# SMTP_PASSWORD=

# Ensure an admin account exists on startup.
# Default admin identity is admin / admin@uniquepos.com.
# Set to 0 to disable admin bootstrap.
# UNIQUEPOS_BOOTSTRAP_ADMIN=1
# UNIQUEPOS_BOOTSTRAP_ADMIN_USERNAME=admin
# UNIQUEPOS_BOOTSTRAP_ADMIN_EMAIL=admin@uniquepos.com
# Required in production.
# UNIQUEPOS_BOOTSTRAP_ADMIN_PASSWORD=admin123
# Set to 1 only if you want each restart to rotate the existing admin password.
# UNIQUEPOS_BOOTSTRAP_ADMIN_ROTATE_PASSWORD=0

# Storage locations (default to folders beside app.js — usually fine as-is):
# SERVE_CLIENT_DIR=./public
# BACKUP_DIR=./backups
# LOCAL_STORAGE_DIR=./storage
