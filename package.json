{
  "name": "uniquepos",
  "version": "1.0.0",
  "private": true,
  "main": "app.js",
  "engines": { "node": ">=22" },
  "files": ["assets/fonts/"],
  "scripts": {
    "build": "node scripts/build.cjs",
    "prestart": "node scripts/build.cjs",
    "start": "node app.js",
    "db:init": "node scripts/bootstrap-db.cjs",
    "db:migrate": "node scripts/run-migrations.cjs",
    "db:generate-initial": "node scripts/generate-initial-migration.cjs",
    "db:verify": "node scripts/verify-schema.cjs",
    "startup:validate": "node scripts/validate-startup-env.cjs",
    "pdf:sample": "node scripts/pdf-fixtures.js",
    "pdf:qa": "node scripts/pdf-fixtures.js && node tests/pdf-structural.cjs",
    "pdf:receipt-smoke": "node scripts/pdf-receipt-smoke.cjs",
    "pdf:download-smoke": "node scripts/pdf-download-smoke.cjs"
  },
  "dependencies": {
    "@leduard/svg-to-pdfkit": "^0.1.10",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.2",
    "drizzle-orm": "^0.45.2",
    "fontkit": "^2.0.4",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.3",
    "pino-pretty": "^13.1.3",
    "read-excel-file": "^9.3.8",
    "thread-stream": "^3.1.0",
    "write-excel-file": "^4.1.1"
  }
}
