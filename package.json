{
  "name": "uniquepos",
  "version": "1.0.0",
  "private": true,
  "main": "app.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.cjs && node scripts/fix-pos-checkout.cjs",
    "start": "node scripts/fix-pos-checkout.cjs && node app.js",
    "db:init": "node scripts/bootstrap-db.cjs",
    "db:migrate": "node scripts/run-migrations.cjs",
    "db:generate-initial": "node scripts/generate-initial-migration.cjs",
    "db:verify": "node scripts/verify-schema.cjs",
    "startup:validate": "node scripts/validate-startup-env.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.2",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "^3.1.0",
    "write-excel-file": "^4.1.1"
  }
}
